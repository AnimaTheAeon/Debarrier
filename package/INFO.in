package="DeBarrier"
version="@VERSION@"
os_min_ver="7.2.1-69057"
displayname="DeBarrier"
description="Gets Materia's indexer searches through Cloudflare. A FlareSolverr-compatible address on port 8191 that uses FlareSolverr or Byparr, running in Container Manager, and falls back to the other when one can't get through."
maintainer="AnimaTheAeon"
maintainer_url="https://github.com/AnimaTheAeon/Materia"
arch="x86_64 r1000 v1000 geminilake apollolake denverton broadwell broadwellnk broadwellnkv2 broadwellntbap purley epyc7002 avoton braswell bromolow cedarview grantley kvmx64"
install_dep_packages="ContainerManager>=20.10.23-1432"
dsmuidir="ui"
dsmappname="DeBarrier.AppInstance"
thirdparty="yes"
ctl_stop="yes"
startable="yes"
silent_install="no"
silent_upgrade="yes"
silent_uninstall="yes"
beta="no"
