#!/bin/sh
mkdir -p "$SYNOPKG_PKGVAR"
# Let the service replace the window's files when it updates itself (ignored if DSM doesn't allow it).
chown -R "$SYNOPKG_PKGNAME:$SYNOPKG_PKGNAME" "$SYNOPKG_PKGDEST/ui" 2>/dev/null || true
{
cat << 'NOTE'
<p style="font-weight:bold;">DeBarrier is installed</p>
<p>Container Manager now runs FlareSolverr and Byparr as a project called <b>debarrier</b>. If they're still downloading, DeBarrier shows them as <b>Not running</b> until they're ready.</p>
<p>Open <b>DeBarrier</b> from the main menu. Its Status page shows the address to put into Materia under <b>Config</b> &rarr; <b>Proxies</b> &rarr; <b>FlareSolverr</b>.</p>
<p>If you already run a FlareSolverr container on port 8191, stop it in Container Manager. DeBarrier replaces it.</p>
NOTE
} >> "$SYNOPKG_TEMP_LOGFILE"
exit 0
